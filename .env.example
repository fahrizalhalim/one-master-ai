# ===== ONE MASTER AI — contoh konfigurasi =====
# Salin file ini menjadi .env lalu isi nilai aslinya. JANGAN commit .env ke Git.

# API Key AI (wajib diisi)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Database
DATABASE_URL=postgresql+psycopg://onemaster:onemaster@db:5432/onemaster
DB_PASSWORD=ubah_password_ini
